{
  "name": "@jobhunter/marketing-agent",
  "version": "0.1.0",
  "description": "Standalone AI marketing agent for generating and optimizing copy. Uses Vercel AI SDK with integrations for HubSpot and analytics.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate-copy": "tsx src/cli.ts generate",
    "review-copy": "tsx src/cli.ts review",
    "test": "tsx --test tests/*.test.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@hubspot/api-client": "^12.0.0",
    "ai": "7.0.127",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "type": "module"
}
