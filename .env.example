# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxx
# Optional fallback if you explicitly set LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# Stable model defaults; explicit environment overrides take precedence.
OPENAI_DEFAULT_MODEL=gpt-6-luna
OPENAI_PREMIUM_MODEL=gpt-6-astra
OPENAI_BROWSER_MODEL=gpt-6-luna
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5-5
ANTHROPIC_PREMIUM_MODEL=claude-opus-5-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BROWSER_MODEL=claude-haiku-4-5-20251001

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Database
DATABASE_URL=postgresql://user:pass@host:5432/db
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=xxx

# Redis
REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# Premium users
PREMIUM_EMAILS=user1@example.com,user2@example.com

# Founder emails (comma-separated) — used for personalized attribution in cover letters/applications
FOUNDER_EMAILS=founder@example.com

# Auth
NEXTAUTH_SECRET=xxx
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
ENABLE_CREDENTIALS_AUTH=false

# Inngest
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=xxx

# Email
RESEND_API_KEY=re_xxx

# Geo
MAXMIND_LICENSE_KEY=xxx

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx

# Proxy (for anti-detection)
PROXY_URL=http://user:pass@proxy-host:22225

# Browser settings
BROWSER_HEADLESS=false   # true = no visible browser windows (better for accessibility/CI)
BROWSER_SLOW_MO=0        # ms delay between Playwright actions (e.g. 100 for smoother headed mode)
BROWSER_MODE=cdp         # cdp = real Chrome, patchright = bundled Chromium, browserbase = cloud browsers

# Browserbase (when BROWSER_MODE=browserbase). Create Contexts once per logged-in board, then map them here.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=false
BROWSERBASE_SESSION_TIMEOUT=900
BROWSERBASE_CONTEXT_IDS=          # e.g. indeed=<context-id>,default=<context-id>
BROWSERBASE_BLOCK_MEDIA=true
BROWSERBASE_VERIFY_LISTINGS=true  # confirm each shortlisted job is open + has an Apply control via POST /v1/fetch
# Required by Stagehand: your backend's public HTTPS origin (no path).
# For local cloud-browser runs, expose the local backend through an HTTPS tunnel.
# SDK traces go to the backend's discard endpoint; request bodies are not read/stored.
BACKEND_PUBLIC_URL=

# Serper (Google Search API for job discovery)
SERPER_API_KEY=xxx
ANTHROPIC_WORKSPACE_ID=   # only if the key is organization-scoped; sent as the anthropic-workspace-id header

# Indeed-only Browserbase demo (also enable BROWSER_MODE=browserbase above)
INDEED_ONLY=false
# Default demo restriction: discover Indeed Easy Apply listings and skip employer
# redirects or additional sign-ins. This also restricts discovery to Indeed even
# when INDEED_ONLY=false. Set BOTH flags below false to restore the broader path;
# keep backend and frontend values aligned (frontend changes require a rebuild).
INDEED_EASY_APPLY_ONLY=true
NEXT_PUBLIC_INDEED_EASY_APPLY_ONLY=true
# Local UI sign-in: development only; requires ENABLE_CREDENTIALS_AUTH=true.
# Use a random password of at least 16 characters. Never commit real values.
LOCAL_DEMO_EMAIL=
LOCAL_DEMO_PASSWORD=
# Required for production builds; use your backend's public URL when deploying.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Gmail code reader; ordinary Google login only needs identity scopes.
ENABLE_GMAIL_VERIFICATION=false

# Account UUID allowed to inherit BROWSERBASE_CONTEXT_IDS (prefer per-user Settings).
BROWSERBASE_CONTEXT_USER_ID=
